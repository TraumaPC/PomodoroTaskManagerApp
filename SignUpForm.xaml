<Window x:Class="PomodoroTaskManagerApp.SignUpForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PomodoroTaskManagerApp"
        mc:Ignorable="d"
        Title="SignUpForm" 
        Height="645" 
        Width="875" 
        WindowStartupLocation ="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        ResizeMode="NoResize" 
        FontSize="18"
        FontFamily="{DynamicResource MaterialDesignFont}">
        
    <Grid Margin="20">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="1"
                              Opacity="0.4"/>
        </Grid.Effect>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.22*"/>
        </Grid.ColumnDefinitions>
        
        <!--LeftSection-->
        <Border Background="#FF57A54C"
                CornerRadius="10 0 0 10"
                ClipToBounds="True">
            <Border.Clip>
                <RectangleGeometry Rect="0,0,400,605"
                                   RadiusX="10"
                                   RadiusY="10"/>
            </Border.Clip>

            <Grid>
                <!--Tittles-->
                <StackPanel VerticalAlignment="Top" Margin="0 120 0 0">

                    <TextBlock FontSize="46" 
                           FontWeight="Light" 
                           Text="Регистрация" 
                           Foreground="#ffffff" 
                           TextAlignment="Center"/>

                    <TextBlock FontSize="16" 
                           FontWeight="Bold" 
                           Text="И используйте все функции" 
                           Foreground="#d1f2eb" 
                           TextAlignment="Center"
                           Margin="0 15 0 3"/>

                    <TextBlock FontSize="16" 
                           FontWeight="Bold" 
                           Text="приложения" 
                           Foreground="#d1f2eb" 
                           TextAlignment="Center"
                           Margin="0 15 0 3"/>
                </StackPanel>

                <!--Круги-->
                <Ellipse Width="500"
                         Height="500"
                         VerticalAlignment="Bottom"
                         Fill="#5eccb4"
                         Margin="50 0 0 -200"
                         Opacity="0.6"/>

                <!--Иконка-->
                <Border Background="#fdfdfd"
                        CornerRadius="100"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Height="110"
                        Width="110"
                        Margin="0 0 0 80">

                </Border>
                <Grid>
                    <!--Цветной круг-->
                    <Ellipse Width="100" Height="100" StrokeThickness="4" >
                        <Ellipse.Stroke>
                            <LinearGradientBrush>
                                <GradientStop Color="#E27C53" Offset="0.15" />
                                <GradientStop Color="#DCA530" Offset="0.2" />
                                <GradientStop Color="#8BB356" Offset="0.3" />
                                <GradientStop Color="#3BB799" Offset="0.4" />
                                <GradientStop Color="#67CBEE" Offset="0.5" />
                                <GradientStop Color="#3699DB" Offset="0.6" />
                                <GradientStop Color="#9264AA" Offset="0.8" />
                                <GradientStop Color="#6E94DE" Offset="0.9" />
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                    </Ellipse>

                    
                </Grid>
            </Grid>
        </Border>

        <!--Right Section-->
        <Border Grid.Column="1" Background="#ffffff" CornerRadius="0 10 10 0" Cursor="" >
            <Grid>

                <!--Inputs-->
                <StackPanel VerticalAlignment="Center" Margin="75 0">
                    <TextBox x:Name="TBULogin" BorderBrush="#C5C8CC" Text="Login"  />
                    <TextBox x:Name="TBUFName" BorderBrush="#C5C8CC" Text="FName"  />
                    <TextBox x:Name="TBULName" BorderBrush="#C5C8CC" Text="LName"  />
                    <PasswordBox x:Name="PBUPass" BorderThickness="0 0 0 1.5" BorderBrush="#C5C8CC"  Password="1234567890"  />
                    <PasswordBox x:Name="PBUPassConfirm" BorderThickness="0 0 0 1.5" BorderBrush="#C5C8CC"  Password="1234567890" Margin="0 27 0 0"  />
                    <CheckBox Margin="0 40 0 20" FontSize="13">
                        <TextBlock>
                            <Run Foreground="#b6b6b6">Подтверждаю </Run>
                            <Run Foreground="#07BF96">Условия и политику</Run>
                        </TextBlock>
                    </CheckBox>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Зарегистрироваться" 
                                Background="#05B790" 
                                Foreground="#ffffff" 
                                FontSize="18" 
                                Click="SignUPBtn_Click"/>
                        <Button Content="Или войти" 
                                RenderTransformOrigin="-0.233,2.266"
                                Click="LoginBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
